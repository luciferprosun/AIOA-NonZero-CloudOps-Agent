{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StopConfiguredTaggedSandboxOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:StopInstances"
      ],
      "Resource": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:instance/${SandboxInstanceId}",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1",
          "aws:ResourceTag/AIOACloudOpsSandbox": "true"
        }
      }
    }
  ]
}
