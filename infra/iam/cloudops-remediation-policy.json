{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReleaseOneManagedElasticIp",
      "Effect": "Allow",
      "Action": [
        "ec2:ReleaseAddress"
      ],
      "Resource": "arn:${Partition}:ec2:eu-central-1:${Account}:elastic-ip/${AllocationId}",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1",
          "aws:ResourceTag/AIOACloudOpsManaged": "true"
        }
      }
    }
  ]
}
