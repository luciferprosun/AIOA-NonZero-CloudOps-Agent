# Local-First Phase 1 is credential-free and mock mode is explicit.
AIOA_LOCAL_MODE=mock
AIOA_LOCAL_STATE_PATH=.local/aioa-local-phase1-state.json

# Local-2 uses separate atomic durable-truth and mock-inventory files.
AIOA_LOCAL_HITL_STATE_PATH=.local/aioa-local-hitl-state.json
AIOA_LOCAL_INVENTORY_PATH=.local/aioa-local-mock-inventory.json
AIOA_LOCAL_APPROVAL_TTL_SECONDS=600
